{
  "name": "dsh-novel-ai",
  "version": "0.3.0",
  "description": "Novel AI 启动器插件 —— 在 DeepSeek Harness 中一键拉起 AI 长篇小说创作系统（独立窗口模式，保留原界面）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "writing",
    "小说",
    "launcher"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:scenario": "node --test tests/scenario/scenarios.mjs",
    "verify": "node lib/verify.js",
    "sync-runtime": "bash scripts/sync-runtime.sh"
  },
  "files": [
    "lib",
    "runtime",
    "web",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shzzzy/dsh-novel-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Shzzzy/dsh-novel-ai/issues"
  },
  "homepage": "https://github.com/Shzzzy/dsh-novel-ai#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
